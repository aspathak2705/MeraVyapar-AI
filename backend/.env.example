# ================================================================
# MERAVYAPAR AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# See root .env.example for comprehensive documentation.
# The backend settings loader reads .env from root or backend/.
# ================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME=MeraVyapar AI API
API_V1_STR=/api/v1
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/meravyapar_db

# Supabase Auth & JWT
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_JWT_SECRET=dev-secret-change-in-production-min-32-chars!!
SUPABASE_STORAGE_BUCKET=financial-evidence
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gnani AI Multilingual Speech Stack
# Enter the Gnani Key ID issued by Vachana Platform (sent via X-API-Key-ID header)
GNANI_API_KEY=replace_with_your_gnani_api_key_id
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_DEFAULT_VOICE=Nalini
GNANI_DEFAULT_LANGUAGE=hi-IN
GNANI_TIMEOUT_SECONDS=10.0

# SerpApi Market Intelligence (Google Search, Shopping, News)
SERPAPI_API_KEY=replace_with_your_serpapi_api_key
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_CACHE_TTL_SECONDS=86400
SERPAPI_TIMEOUT_SECONDS=10.0

# OpenRouter / NVIDIA Nemotron 3
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FINANCIAL_INTELLIGENCE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEMOTRON_REASONING_ENABLED=true

# Provider Simulation Modes
EXTERNAL_PROVIDER_MODE=simulation
ENABLE_DEMO_ENDPOINTS=true
WHATSAPP_PROVIDER=simulation
SMS_PROVIDER=simulation
PAYMENT_PROVIDER=simulation

# Cache
REDIS_URL=redis://localhost:6379/0
