# ================================================================
# MERAVYAPAR AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ================================================================
# Instructions:
# 1. Copy this template to .env in the project root:
#    cp .env.example .env
# 2. Replace the placeholders below with your actual credentials.
# 3. Never commit .env to source control (.gitignore protects .env).
# ================================================================

# ================================================================
# 1. APPLICATION & SERVER RUNTIME
# ================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME=MeraVyapar AI API
API_V1_STR=/api/v1
# Base URL for local Flutter client communication
API_BASE_URL=http://localhost:8000

# ================================================================
# 2. DATABASE CONFIGURATION (POSTGRESQL 18)
# ================================================================
# Canonical source of truth for all financial transactions and ledgers
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/meravyapar_db

# ================================================================
# 3. AUTHENTICATION & STORAGE (SUPABASE)
# ================================================================
# Supabase project URL and anon public key (Required for JWT validation)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
# JWT Secret matching your Supabase project (min 32 chars)
SUPABASE_JWT_SECRET=dev-secret-change-in-production-min-32-chars!!

# Private evidence storage bucket name
SUPABASE_STORAGE_BUCKET=financial-evidence
# Privileged service role key (Backend only, optional for local dev)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ================================================================
# 4. GNANI AI MULTILINGUAL SPEECH STACK (BACKEND ONLY)
# ================================================================
# Gnani Vachana AI Platform API Key ID
# Note: Gnani authenticates using the 'X-API-Key-ID' header.
# Enter your Gnani Key ID / credential issued from api.vachana.ai.
# (If left empty, voice endpoints return HTTP 503 without crashing the backend)
GNANI_API_KEY=replace_with_your_gnani_api_key_id

# Gnani Vachana Base URL (Default: https://api.vachana.ai)
GNANI_API_BASE_URL=https://api.vachana.ai

# Speech-to-Text Model (Default: prisma-v2.5)
GNANI_STT_MODEL=prisma-v2.5

# Text-to-Speech Model (Default: timbre-v2.5)
GNANI_TTS_MODEL=timbre-v2.5

# Default vernacular voice profile and language
GNANI_DEFAULT_VOICE=Nalini
GNANI_DEFAULT_LANGUAGE=hi-IN

# Network request timeout in seconds
GNANI_TIMEOUT_SECONDS=10.0

# ================================================================
# 5. SERPAPI MARKET INTELLIGENCE FOUNDATION (BACKEND ONLY)
# ================================================================
# SerpApi API Key for external market intelligence queries
# Active engines: Google Search (google), Google Shopping (google_shopping), Google News (google_news)
# (If left empty, market research planner returns controlled unconfigured status)
SERPAPI_API_KEY=replace_with_your_serpapi_api_key

# SerpApi Base URL (Default: https://serpapi.com/search)
SERPAPI_BASE_URL=https://serpapi.com/search

# Deterministic Cache TTL in seconds (Default: 86400 = 24 hours)
SERPAPI_CACHE_TTL_SECONDS=86400

# Network request timeout in seconds
SERPAPI_TIMEOUT_SECONDS=10.0

# ================================================================
# 6. FINANCIAL REASONING — NVIDIA NEMOTRON 3 (BACKEND ONLY)
# ================================================================
# OpenRouter API Key for Nemotron grounded reasoning
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FINANCIAL_INTELLIGENCE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEMOTRON_REASONING_ENABLED=true

# ================================================================
# 7. EXTERNAL COMMUNICATION & ACTION DISPATCH MODES
# ================================================================
# Modes: simulation (default/safe for testing), production, disabled
EXTERNAL_PROVIDER_MODE=simulation
ENABLE_DEMO_ENDPOINTS=true

# WhatsApp dispatch settings
WHATSAPP_PROVIDER=simulation
WHATSAPP_PROVIDER_KEY=

# SMS dispatch settings
SMS_PROVIDER=simulation
SMS_PROVIDER_KEY=

# Payment Gateway settings
PAYMENT_PROVIDER=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ================================================================
# 8. INTERNAL INGESTION & SECURITY (BACKEND ONLY)
# ================================================================
# Secret key required to ingest external market events into /api/v1/market-intelligence/ingest
# Authenticates via header 'X-Internal-Ingest-Key' or 'Authorization: Bearer <key>'
# (If unset, ingestion route strictly rejects requests with HTTP 401)
INTERNAL_INGEST_API_KEY=replace_with_internal_ingest_secret_key_min_32_chars
ALLOW_INSECURE_INTERNAL_INGEST=false

# ================================================================
# 9. CACHE & COMPILATION SETTINGS (OPTIONAL)
# ================================================================
REDIS_URL=redis://localhost:6379/0
