# ================================================================
# MERAVYAPAR AI - INFRASTRUCTURE ENVIRONMENT CONFIGURATION
# ================================================================

# ================================================================
# DATABASE (BACKEND ONLY)
# ================================================================
# Supabase PostgreSQL connection string with password & pooler/direct connection
DATABASE_URL=postgresql://postgres:your_db_password@db.your_supabase_ref.supabase.co:5432/postgres

# ================================================================
# SUPABASE AUTH & STORAGE CONFIGURATION
# ================================================================
# Public client configuration (Safe for Frontend / Flutter --dart-define)
SUPABASE_URL=https://your_supabase_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Backend-only private storage bucket name
SUPABASE_STORAGE_BUCKET=financial-evidence

# Backend-only privileged service role key (NEVER EXPOSE TO FRONTEND)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend API base URL for Flutter client API requests
API_BASE_URL=http://localhost:8000

# Backend JWT Secret (Matches Supabase Auth JWT secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ================================================================
# FINANCIAL INTELLIGENCE — OPENROUTER (BACKEND ONLY)
# ================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FINANCIAL_INTELLIGENCE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEMOTRON_REASONING_ENABLED=true

BRAVE_API_KEY=

# ================================================================
# EXTERNAL PROVIDER INTEGRATION MODE (BACKEND ONLY)
# ================================================================
# Modes: simulation (default/demo), production, disabled
EXTERNAL_PROVIDER_MODE=simulation

# Communication Providers
WHATSAPP_PROVIDER=simulation
WHATSAPP_PROVIDER_KEY=

SMS_PROVIDER=simulation
SMS_PROVIDER_KEY=

# Payment Providers
PAYMENT_PROVIDER=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

